diff --git a/sdk/cliproxy/auth/fleet_credit_routing.go b/sdk/cliproxy/auth/fleet_credit_routing.go
new file mode 100644
--- /dev/null
+++ b/sdk/cliproxy/auth/fleet_credit_routing.go
@@ -0,0 +1,281 @@
+package auth
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/registry"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+	"github.com/tidwall/gjson"
+)
+
+type fleetCreditContextKey struct{}
+type fleetPriorityContextKey struct{}
+
+type fleetRoutingPolicy struct {
+	Version   int               `json:"version"`
+	Credits   map[string]string `json:"credits"`
+	Selection map[string]string `json:"selection"`
+}
+
+func fleetPriorityCandidates(ctx context.Context, auths []*Auth) []*Auth {
+	modes, _ := ctx.Value(fleetPriorityContextKey{}).(map[string]string)
+	if len(modes) == 0 {
+		return auths
+	}
+	best := map[string]int{}
+	for _, a := range auths {
+		if modes[a.Provider] != "priority" {
+			continue
+		}
+		rank := authPriority(a)
+		if previous, ok := best[a.Provider]; !ok || rank > previous {
+			best[a.Provider] = rank
+		}
+	}
+	filtered := make([]*Auth, 0, len(auths))
+	for _, a := range auths {
+		if modes[a.Provider] != "priority" || authPriority(a) == best[a.Provider] {
+			filtered = append(filtered, a)
+		}
+	}
+	return filtered
+}
+
+func fleetCreditPolicy() (fleetRoutingPolicy, error) {
+	path := os.Getenv("FLEET_ACCOUNT_ROUTING_FILE")
+	if path == "" {
+		home, err := os.UserHomeDir()
+		if err != nil {
+			return fleetRoutingPolicy{}, err
+		}
+		path = filepath.Join(home, ".local", "state", "fleet", "account-routing.json")
+	}
+	body, err := os.ReadFile(path)
+	if errors.Is(err, os.ErrNotExist) {
+		return fleetRoutingPolicy{}, nil
+	}
+	if err != nil {
+		return fleetRoutingPolicy{}, err
+	}
+	var policy fleetRoutingPolicy
+	if err = json.Unmarshal(body, &policy); err != nil || policy.Version != 1 {
+		return fleetRoutingPolicy{}, errors.New("invalid Fleet credit policy")
+	}
+	for provider, mode := range policy.Credits {
+		if (provider != "claude" && provider != "codex") || (mode != "never" && mode != "last" && mode != "same-account") {
+			return fleetRoutingPolicy{}, errors.New("invalid Fleet credit policy")
+		}
+	}
+	for provider, mode := range policy.Selection {
+		if (provider != "claude" && provider != "codex") || mode != "priority" {
+			return fleetRoutingPolicy{}, errors.New("invalid Fleet selection policy")
+		}
+	}
+	return policy, nil
+}
+
+func (m *Manager) fleetCreditContext(ctx context.Context, providers []string, model string, opts cliproxyexecutor.Options) (context.Context, error) {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	if ctx.Value(fleetCreditContextKey{}) != nil {
+		return ctx, nil
+	}
+	policy, err := fleetCreditPolicy()
+	if err != nil {
+		return ctx, &Error{Code: "fleet_credit_policy_invalid", Message: "Fleet credit policy is unavailable; request stopped to protect credits", HTTPStatus: 503}
+	}
+	ctx = context.WithValue(ctx, fleetPriorityContextKey{}, policy.Selection)
+	active := map[string]string{}
+	for _, provider := range providers {
+		if mode := policy.Credits[provider]; mode == "never" || mode == "last" {
+			active[provider] = mode
+		}
+	}
+	if len(active) == 0 {
+		return ctx, nil
+	}
+	allowed := map[string]bool{}
+	plan := map[string]bool{}
+	unknown := map[string]bool{}
+	paid := map[string]bool{}
+	auths := m.List()
+	eligibility := authSelectionEligibilityForRequest(ctx, opts)
+	for _, a := range auths {
+		if active[a.Provider] == "" || a.AuthKind() != AuthKindOAuth || a.Disabled || a.Status == StatusDisabled || !eligibility.allows(a) {
+			continue
+		}
+		if model != "" && !eligibility.allowUnregisteredModel && !m.authSupportsRouteModel(registry.GetGlobalRegistry(), a, model) {
+			continue
+		}
+		allowed[a.ID] = false
+		if a.Provider == "claude" && gjson.GetBytes(opts.OriginalRequest, "speed").String() == "fast" {
+			return ctx, &Error{Code: "fleet_credit_required", Message: "Claude fast mode requires credits; select same-account to allow it", HTTPStatus: 400}
+		}
+		body := m.fleetCreditUsage(ctx, a)
+		available, known, credits := fleetUsageFunding(a.Provider, model, body)
+		if !known {
+			unknown[a.Provider] = true
+			continue
+		}
+		if available {
+			if blocked, reason, _ := isAuthBlockedForModel(a, m.selectionModelKeyForAuth(a, model), time.Now()); policy.Selection[a.Provider] == "priority" && blocked && reason == blockReasonCooldown && fleetQuotaCooled(a, time.Now()) {
+				onlyModel := model
+				if fleetUsageAvailable(a.Provider, body) {
+					onlyModel = ""
+				}
+				if _, _, err := m.resetQuota(ctx, a.ID, onlyModel); err != nil {
+					return ctx, err
+				}
+			}
+			allowed[a.ID] = true
+			plan[a.Provider] = true
+		}
+		if credits {
+			paid[a.ID] = true
+		}
+	}
+	for _, a := range auths {
+		if _, managed := allowed[a.ID]; managed && active[a.Provider] == "last" && !plan[a.Provider] && !unknown[a.Provider] && paid[a.ID] {
+			allowed[a.ID] = true
+		}
+	}
+	found := false
+	for _, a := range auths {
+		if a.Disabled || !eligibility.allows(a) {
+			continue
+		}
+		for _, provider := range providers {
+			if a.Provider == provider && (active[provider] == "" || allowed[a.ID]) {
+				found = true
+			}
+		}
+	}
+	if !found {
+		if len(unknown) > 0 {
+			return ctx, &Error{Code: "fleet_credit_usage_unavailable", Message: "Subscription usage check is unavailable; request stopped to protect credits. Try again shortly", HTTPStatus: 503}
+		}
+		return ctx, &Error{Code: "fleet_credit_blocked", Message: "No verified subscription allowance or permitted credits available", HTTPStatus: 429}
+	}
+	return context.WithValue(ctx, fleetCreditContextKey{}, allowed), nil
+}
+
+type fleetCreditUsageEntry struct {
+	sync.Mutex
+	token string
+	until time.Time
+	body  []byte
+}
+
+func (m *Manager) fleetCreditUsage(ctx context.Context, a *Auth) []byte {
+	if a.Provider != "claude" {
+		body, _ := m.fleetUsage(ctx, a)
+		return body
+	}
+	cached, _ := m.fleetCreditUsageCache.LoadOrStore(a.ID, &fleetCreditUsageEntry{})
+	entry := cached.(*fleetCreditUsageEntry)
+	entry.Lock()
+	defer entry.Unlock()
+	if entry.token == authAccessToken(a) && time.Now().Before(entry.until) && (len(entry.body) == 0 || !fleetQuotaCooled(a, time.Now())) {
+		return entry.body
+	}
+	body, retry := m.fleetUsage(ctx, a)
+	entry.body = nil
+	entry.until = time.Time{}
+	entry.token = authAccessToken(a)
+	if gjson.GetBytes(body, "extra_usage.is_enabled").Type == gjson.False && fleetUsageAvailable(a.Provider, body) {
+		entry.body = body
+		entry.until = time.Now().Add(5 * time.Minute)
+		windows := gjson.GetBytes(body, "limits").Array()
+		for _, key := range []string{"five_hour", "seven_day", "seven_day_opus", "seven_day_sonnet", "seven_day_fable"} {
+			windows = append(windows, gjson.GetBytes(body, key))
+		}
+		for _, window := range windows {
+			if reset, err := time.Parse(time.RFC3339, window.Get("resets_at").String()); err == nil && reset.Before(entry.until) {
+				entry.until = reset
+			}
+		}
+	} else if retry > 0 && ctx.Err() == nil {
+		entry.until = time.Now().Add(retry)
+	} else {
+		entry.until = time.Time{}
+	}
+	return body
+}
+
+func fleetUsageFunding(provider, model string, body []byte) (bool, bool, bool) {
+	if !gjson.ValidBytes(body) {
+		return false, false, false
+	}
+	root := gjson.ParseBytes(body)
+	switch provider {
+	case "codex":
+		limit := root.Get("rate_limit")
+		for _, extra := range root.Get("additional_rate_limits").Array() {
+			if extra.Get("normal_model_slug").String() == model && model != "" {
+				limit = extra.Get("rate_limit")
+			}
+		}
+		known := limit.IsObject() && (limit.Get("limit_reached").Type == gjson.False || limit.Get("limit_reached").Type == gjson.True)
+		blocked := limit.Get("limit_reached").Bool() || limit.Get("allowed").Type == gjson.False
+		for _, key := range []string{"primary_window", "secondary_window"} {
+			w := limit.Get(key + ".used_percent")
+			if w.Type == gjson.Number {
+				known = true
+				blocked = blocked || w.Float() >= 100
+			}
+		}
+		usage := root.Get("model_usage").Map()[model]
+		blocked = blocked || usage.Get("credits_would_enable").Bool() || usage.Get("available").Type == gjson.False
+		credits := (root.Get("credits.has_credits").Bool() || root.Get("credits.unlimited").Bool()) && !root.Get("credits.overage_limit_reached").Bool() && !root.Get("spend_control.reached").Bool()
+		return known && !blocked, known, credits
+	case "claude":
+		known, blocked := false, false
+		for _, key := range []string{"five_hour", "seven_day", "seven_day_opus", "seven_day_sonnet", "seven_day_fable"} {
+			if strings.HasPrefix(key, "seven_day_") && !strings.Contains(strings.ToLower(model), strings.TrimPrefix(key, "seven_day_")) {
+				continue
+			}
+			w := root.Get(key + ".utilization")
+			if w.Type == gjson.Number {
+				known = true
+				blocked = blocked || w.Float() >= 100
+			}
+		}
+		for _, w := range root.Get("limits").Array() {
+			if scope := w.Get("scope.model"); model != "" && scope.IsObject() {
+				named, matches := false, false
+				for _, field := range []string{"id", "display_name"} {
+					if name := scope.Get(field).String(); name != "" {
+						named = true
+						matches = matches || strings.Contains(strings.ToLower(model), strings.ToLower(name))
+					}
+				}
+				if named && !matches {
+					continue
+				}
+			}
+			percent := w.Get("percent")
+			if percent.Type == gjson.Number {
+				known = true
+				blocked = blocked || percent.Float() >= 100
+			}
+		}
+		extra := root.Get("extra_usage")
+		credits := extra.Get("is_enabled").Bool()
+		if p := extra.Get("utilization"); p.Type == gjson.Number && p.Float() >= 100 {
+			credits = false
+		}
+		if limit := extra.Get("monthly_limit"); limit.Type == gjson.Number {
+			credits = credits && limit.Float() > extra.Get("used_credits").Float()
+		}
+		return known && !blocked, known, credits
+	}
+	return false, false, false
+}

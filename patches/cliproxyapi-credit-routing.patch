+func TestFleetCreditUsageDoesNotCachePaidOrUnknownUsage(t *testing.T) {
+	for _, tc := range []struct{ provider, body string }{
+		{"claude", `{"five_hour":{"utilization":6},"extra_usage":{"is_enabled":true}}`},
+		{"claude", `{"five_hour":{"utilization":6}}`},
+		{"claude", `{"extra_usage":{"is_enabled":false}}`},
+		{"claude", `{"five_hour":{"utilization":100},"extra_usage":{"is_enabled":false}}`},
+		{"codex", `{"rate_limit":{"limit_reached":false}}`},
+	} {
+		executor := &fleetCreditTestExecutor{schedulerProviderTestExecutor: schedulerProviderTestExecutor{provider: tc.provider}, bodies: map[string]string{"a": tc.body}, rateAfter: 1}
+		manager := NewManager(nil, &FillFirstSelector{}, nil)
+		manager.RegisterExecutor(executor)
+		a := &Auth{ID: "a", Provider: tc.provider}
+		manager.fleetCreditUsage(context.Background(), a)
+		if body := manager.fleetCreditUsage(context.Background(), a); len(body) != 0 || executor.calls != 2 {
+			t.Fatalf("cached unverifiable credit state for %s: %s, calls=%d", tc.provider, body, executor.calls)
+		}
+		if tc.provider == "claude" {
+			cached, _ := manager.fleetCreditUsageCache.Load(a.ID)
+			if time.Until(cached.(*fleetCreditUsageEntry).until) < 2*time.Minute {
+				t.Fatal("provider Retry-After was not honored")
+			}
+			if body := manager.fleetCreditUsage(context.Background(), a); len(body) != 0 || executor.calls != 2 {
+				t.Fatalf("usage retry ignored its backoff: %s, calls=%d", body, executor.calls)
+			}
+		}
+	}
+}

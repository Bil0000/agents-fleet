+}
+func TestFleetUsageRefreshesExpiredToken(t *testing.T) {
+	executor := &fleetCreditTestExecutor{schedulerProviderTestExecutor: schedulerProviderTestExecutor{provider: "claude"}, bodies: map[string]string{"a": `{"five_hour":{"utilization":0}}`}, unauthorized: true}
+	manager := NewManager(nil, &FillFirstSelector{}, nil)
+	manager.RegisterExecutor(executor)
+	a, err := manager.Register(context.Background(), &Auth{ID: "a", Provider: "claude", Status: StatusActive, Metadata: map[string]any{"access_token": "expired"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	body, _ := manager.fleetUsage(context.Background(), a)
+	if executor.refreshes != 1 || executor.calls != 2 || string(body) != executor.bodies["a"] {
+		t.Fatalf("calls=%d refreshes=%d body=%s", executor.calls, executor.refreshes, body)
+	}
+}

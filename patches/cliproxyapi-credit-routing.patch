+
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+)
+
+type fleetCreditTestExecutor struct {
+	schedulerProviderTestExecutor
+	bodies       map[string]string
+	calls        int
+	unauthorized bool
+	refreshes    int
+	rateAfter    int
+}
+
+func (e *fleetCreditTestExecutor) PrepareRequest(req *http.Request, a *Auth) error { return nil }
+func (e *fleetCreditTestExecutor) HttpRequest(ctx context.Context, a *Auth, req *http.Request) (*http.Response, error) {
+	e.calls++
+	if e.rateAfter > 0 && e.calls > e.rateAfter {
+		return &http.Response{StatusCode: 429, Header: http.Header{"Retry-After": []string{"180"}}, Body: io.NopCloser(strings.NewReader("rate limited"))}, nil
+	}
+	if e.unauthorized && e.calls == 1 {
+		return &http.Response{StatusCode: 401, Body: io.NopCloser(strings.NewReader("unauthorized"))}, nil
+	}
+	return &http.Response{StatusCode: 200, Body: io.NopCloser(strings.NewReader(e.bodies[a.ID]))}, nil
+}
+
+func TestFleetCreditRouting(t *testing.T) {
+	for _, provider := range []string{"codex", "claude"} {
+		for _, path := range []string{"single", "mixed", "legacy", "select"} {
+			for _, tc := range []struct{ mode, second, want string }{
+				{"never", "available", "b"}, {"last", "available", "b"}, {"same-account", "available", "a"},
+				{"last", "exhausted", "a"}, {"never", "exhausted", ""}, {"last", "unknown", ""},
+			} {
+				t.Run(provider+"/"+path+"/"+tc.mode+"/"+tc.second, func(t *testing.T) {
+					file := filepath.Join(t.TempDir(), "routing.json")
+					t.Setenv("FLEET_ACCOUNT_ROUTING_FILE", file)
+					policy, _ := json.Marshal(map[string]any{"version": 1, "credits": map[string]string{provider: tc.mode}})
+					if err := os.WriteFile(file, policy, 0600); err != nil {
+						t.Fatal(err)
+					}
+					available := `{"rate_limit":{"limit_reached":false,"primary_window":{"used_percent":0}},"credits":{"has_credits":true}}`
+					exhausted := `{"rate_limit":{"limit_reached":true,"primary_window":{"used_percent":100}},"credits":{"has_credits":true}}`
+					if provider == "claude" {
+						available = `{"five_hour":{"utilization":0},"seven_day":{"utilization":0},"extra_usage":{"is_enabled":true,"monthly_limit":100,"used_credits":0}}`
+						exhausted = `{"five_hour":{"utilization":100},"seven_day":{"utilization":0},"extra_usage":{"is_enabled":true,"monthly_limit":100,"used_credits":0}}`
+					}
+					second := map[string]string{"available": available, "exhausted": exhausted, "unknown": `{}`}[tc.second]
+					executor := &fleetCreditTestExecutor{schedulerProviderTestExecutor: schedulerProviderTestExecutor{provider: provider}, bodies: map[string]string{"a": exhausted, "b": second}}
+					manager := NewManager(nil, &FillFirstSelector{}, nil)
+					manager.RegisterExecutor(executor)
+					for id, priority := range map[string]string{"a": "2", "b": "1"} {
+						_, err := manager.Register(context.Background(), &Auth{ID: id, Provider: provider, Status: StatusActive, Attributes: map[string]string{AttributeAuthKind: AuthKindOAuth, "priority": priority}})

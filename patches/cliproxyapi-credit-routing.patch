+func TestFleetClaudeCreditUsageCache(t *testing.T) {
+	body := `{"five_hour":{"utilization":6},"seven_day":{"utilization":15},"extra_usage":{"is_enabled":false}}`
+	executor := &fleetCreditTestExecutor{schedulerProviderTestExecutor: schedulerProviderTestExecutor{provider: "claude"}, bodies: map[string]string{"a": body}, rateAfter: 1}
+	manager := NewManager(nil, &FillFirstSelector{}, nil)
+	manager.RegisterExecutor(executor)
+	a := &Auth{ID: "a", Provider: "claude", Metadata: map[string]any{"access_token": "first"}}
+	var calls sync.WaitGroup
+	for range 20 {
+		calls.Add(1)
+		go func() {
+			defer calls.Done()
+			if got := manager.fleetCreditUsage(context.Background(), a); string(got) != body {
+				t.Errorf("verified no-credit allowance lost: %s", got)
+			}
+		}()
+	}
+	calls.Wait()
+	if executor.calls != 1 {
+		t.Fatalf("usage requests = %d, want one", executor.calls)
+	}
+	executor.rateAfter = 0
+	a.Metadata["access_token"] = "changed"
+	manager.fleetCreditUsage(context.Background(), a)
+	a.Quota = QuotaState{Exceeded: true, Reason: "quota", NextRecoverAt: time.Now().Add(time.Hour)}
+	manager.fleetCreditUsage(context.Background(), a)
+	a.Quota = QuotaState{}
+	cached, _ := manager.fleetCreditUsageCache.Load(a.ID)
+	cached.(*fleetCreditUsageEntry).until = time.Now().Add(-time.Second)
+	manager.fleetCreditUsage(context.Background(), a)
+	if executor.calls != 4 {
+		t.Fatalf("token, quota, or expiry did not recheck usage: %d", executor.calls)
+	}
+}

@@ -0,0 +1,25 @@
+package auth
+
+import "testing"
+
+func TestFleetUsageAvailable(t *testing.T) {
+	cases := []struct {
+		provider string
+		body     string
+		want     bool
+	}{
+		{"codex", `{"rate_limit":{"limit_reached":false,"primary_window":{"used_percent":0}},"additional_rate_limits":[{"rate_limit":{"limit_reached":false}}]}`, true},
+		{"codex", `{"rate_limit":{"limit_reached":true,"primary_window":{"used_percent":100}}}`, false},
+		{"codex", `{"rate_limit":{"limit_reached":false},"additional_rate_limits":[{"rate_limit":{"limit_reached":true}}]}`, false},
+		{"codex", `{"error":"unauthorized"}`, false},
+		{"claude", `{"limits":[{"kind":"session","percent":17},{"kind":"weekly_all","percent":11}]}`, true},
+		{"claude", `{"limits":[{"kind":"session","percent":17},{"kind":"weekly_all","percent":100}]}`, false},
+		{"claude", `{}`, false},
+		{"gemini", `{}`, false},
+	}
+	for _, c := range cases {
+		if got := fleetUsageAvailable(c.provider, []byte(c.body)); got != c.want {
+			t.Errorf("%s %s: got %v want %v", c.provider, c.body, got, c.want)
+		}
+	}
+}

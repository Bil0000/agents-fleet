+func TestFleetRepro_SecondCodexAccountUsedAfterPrimaryQuota(t *testing.T) {
+	for _, providerRoute := range []bool{false, true} {
+		t.Run(map[bool]string{false: "no-route", true: "provider-route"}[providerRoute], func(t *testing.T) {
+			ctx := context.Background()
+			manager := NewManager(nil, &FillFirstSelector{}, nil)
+			manager.SetRetryConfig(0, 0, 0)
+			manager.RegisterExecutor(fleetReproExecutor{failing: map[string]bool{"pro": true}})
+			reg := registry.GetGlobalRegistry()
+			for _, id := range []string{"pro", "prolite"} {
+				reg.RegisterClient(id, "codex", fleetReproModels())
+			}
+			t.Cleanup(func() {
+				reg.UnregisterClient("pro")
+				reg.UnregisterClient("prolite")
+			})
+			pro := &Auth{ID: "pro", Provider: "codex", Attributes: map[string]string{"priority": "100", "plan_type": "pro"}}
+			prolite := &Auth{ID: "prolite", Provider: "codex", Attributes: map[string]string{"priority": "0", "plan_type": "prolite"}}
+			for _, a := range []*Auth{pro, prolite} {
+				if _, err := manager.Register(ctx, a); err != nil {
+					t.Fatal(err)
+				}
+				manager.RefreshSchedulerEntry(a.ID)
+			}
+			opts := cliproxyexecutor.Options{Metadata: map[string]any{}}
+			if providerRoute {
+				opts.Metadata[cliproxyexecutor.ProviderRouteMetadataKey] = true
+			}
+			first, err := manager.Execute(ctx, []string{"codex"}, cliproxyexecutor.Request{Model: "gpt-6-astra"}, opts)
+			if err != nil {
+				t.Fatalf("first execute: %v", err)
+			}
+			if string(first.Payload) != "ok:prolite" {
+				t.Fatalf("first payload = %q", first.Payload)
+			}
+			cooled, _ := manager.GetByID("pro")
+			if _, _, next := isAuthBlockedForModel(cooled, "gpt-6-astra", time.Now()); next.After(time.Now().Add(5*time.Minute + time.Second)) {
+				t.Fatalf("pro cooldown ends at %s, want at most five minutes", next)
+			}
+			for _, model := range []string{"gpt-6-astra", "gpt-5.6-sol", "gpt-5.6-luna", "codex-auto-review"} {
+				resp, err := manager.Execute(ctx, []string{"codex"}, cliproxyexecutor.Request{Model: model}, opts)
+				var cd *modelCooldownError
+				if errors.As(err, &cd) {
+					t.Fatalf("model %s: got model_cooldown %v (resetIn=%s)", model, err, cd.resetIn.Round(time.Second))
+				}
+				if err != nil {
+					t.Fatalf("model %s: %v", model, err)
+				}
+				if string(resp.Payload) != "ok:prolite" {
+					t.Fatalf("model %s payload = %q", model, resp.Payload)
+				}
+			}
+		})
+	}

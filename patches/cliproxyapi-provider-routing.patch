diff --git a/sdk/cliproxy/auth/fleet_quota_probe.go b/sdk/cliproxy/auth/fleet_quota_probe.go
new file mode 100644
index 0000000..f372094
--- /dev/null
+++ b/sdk/cliproxy/auth/fleet_quota_probe.go
@@ -0,0 +1,127 @@
+package auth
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"strings"
+	"time"
+
+	log "github.com/sirupsen/logrus"
+	"github.com/tidwall/gjson"
+)
+
+const fleetQuotaProbeInterval = time.Minute
+
+// runFleetQuotaProbe re-checks quota-cooled OAuth credentials against the
+// provider's usage endpoint so a banked or early reset clears the cooldown
+// without waiting for the reset hint from the original 429.
+func (m *Manager) runFleetQuotaProbe(ctx context.Context) {
+	ticker := time.NewTicker(fleetQuotaProbeInterval)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+			m.fleetQuotaProbeOnce(ctx)
+		}
+	}
+}
+
+func (m *Manager) fleetQuotaProbeOnce(ctx context.Context) {
+	now := time.Now()
+	for _, auth := range m.List() {
+		if ctx.Err() != nil {
+			return
+		}
+		if auth.AuthKind() != AuthKindOAuth || !fleetQuotaCooled(auth, now) || !m.fleetQuotaReset(ctx, auth) {
+			continue
+		}
+		if _, _, err := m.ResetQuota(ctx, auth.ID); err != nil {
+			log.WithError(err).Warnf("fleet quota probe: reset failed for %s", auth.ID)
+			continue
+		}
+		log.Infof("fleet quota probe: %s reports quota available again, cooldown cleared for %s", auth.Provider, auth.ID)
+	}
+}
+
+func fleetQuotaCooled(auth *Auth, now time.Time) bool {
+	states := []QuotaState{auth.Quota}
+	for _, state := range auth.ModelStates {
+		if state != nil {
+			states = append(states, state.Quota)
+		}
+	}
+	for _, q := range states {
+		if q.Exceeded && q.NextRecoverAt.After(now) && (q.Reason == "quota" || q.Reason == "credential_quota") {
+			return true
+		}
+	}
+	return false
+}
+
+// fleetQuotaReset reports true only when the provider's usage endpoint answers
+// and reports no limit reached.
+func (m *Manager) fleetQuotaReset(ctx context.Context, auth *Auth) bool {
+	var url string
+	headers := make(http.Header)
+	headers.Set("Accept", "application/json")
+	switch strings.ToLower(strings.TrimSpace(auth.Provider)) {
+	case "codex":
+		url = "https://chatgpt.com/backend-api/wham/usage"
+		headers.Set("User-Agent", "codex_cli_rs/0.153.4")
+		headers.Set("Originator", "codex_cli_rs")
+		if accountID, _ := auth.Metadata["account_id"].(string); strings.TrimSpace(accountID) != "" {
+			headers.Set("Chatgpt-Account-Id", accountID)
+		}
+	case "claude":
+		url = "https://api.anthropic.com/api/oauth/usage"
+		headers.Set("User-Agent", "claude-cli/2.1.258 (external, cli)")
+		headers.Set("Anthropic-Beta", "oauth-2025-04-20")
+	default:
+		return false
+	}
+	ctx, cancel := context.WithTimeout(ctx, 15*time.Second)
+	defer cancel()
+	req, err := m.NewHttpRequest(ctx, auth, http.MethodGet, url, nil, headers)
+	if err != nil {
+		return false
+	}
+	resp, err := m.HttpRequest(ctx, auth, req)
+	if err != nil {
+		return false
+	}
+	defer func() { _ = resp.Body.Close() }()
+	body, err := io.ReadAll(resp.Body)
+	if err != nil || resp.StatusCode != http.StatusOK {
+		return false
+	}
+	return fleetUsageAvailable(auth.Provider, body)
+}
+
+func fleetUsageAvailable(provider string, body []byte) bool {
+	root := gjson.ParseBytes(body)
+	switch strings.ToLower(strings.TrimSpace(provider)) {
+	case "codex":
+		main := root.Get("rate_limit")
+		if !main.Exists() || main.Get("limit_reached").Bool() {
+			return false
+		}
+		for _, extra := range root.Get("additional_rate_limits").Array() {
+			if extra.Get("rate_limit.limit_reached").Bool() {
+				return false
+			}
+		}
+		return true
+	case "claude":
+		limits := root.Get("limits").Array()
+		for _, limit := range limits {
+			if limit.Get("percent").Float() >= 100 {
+				return false
+			}
+		}
+		return len(limits) > 0
+	}
+	return false
+}

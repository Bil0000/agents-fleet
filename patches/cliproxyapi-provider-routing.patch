+func IsRetryableConnectionError(err error) bool {
+	if err == nil || statusCodeFromError(err) != 0 || errors.Is(err, context.Canceled) || errors.Is(err, context.DeadlineExceeded) {
+		return false
+	}
+	message := strings.ToLower(strings.TrimSpace(err.Error()))
+	return errors.Is(err, syscall.ECONNRESET) || errors.Is(err, syscall.EPIPE) || errors.Is(err, syscall.ETIMEDOUT) ||
+		strings.HasSuffix(message, "connection reset by peer") ||
+		strings.HasSuffix(message, "broken pipe") ||
+		strings.HasSuffix(message, "i/o timeout")
+}
+

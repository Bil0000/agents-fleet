@@ -0,0 +1,173 @@
+package api
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	coreexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+)
+
+type providerModelsCaptureExecutor struct {
+	provider string
+	request  *http.Request
+	body     string
+	status   int
+}
+
+func (e *providerModelsCaptureExecutor) Identifier() string { return e.provider }
+func (e *providerModelsCaptureExecutor) Execute(context.Context, *auth.Auth, coreexecutor.Request, coreexecutor.Options) (coreexecutor.Response, error) {
+	return coreexecutor.Response{}, nil
+}
+func (e *providerModelsCaptureExecutor) ExecuteStream(context.Context, *auth.Auth, coreexecutor.Request, coreexecutor.Options) (*coreexecutor.StreamResult, error) {
+	return nil, nil
+}
+func (e *providerModelsCaptureExecutor) Refresh(_ context.Context, a *auth.Auth) (*auth.Auth, error) {
+	return a, nil
+}
+func (e *providerModelsCaptureExecutor) CountTokens(context.Context, *auth.Auth, coreexecutor.Request, coreexecutor.Options) (coreexecutor.Response, error) {
+	return coreexecutor.Response{}, nil
+}
+func (e *providerModelsCaptureExecutor) PrepareRequest(req *http.Request, a *auth.Auth) error {
+	if token, _ := a.Metadata["access_token"].(string); token != "" {
+		req.Header.Set("Authorization", "Bearer "+token)
+	}
+	return nil
+}
+func (e *providerModelsCaptureExecutor) HttpRequest(_ context.Context, _ *auth.Auth, req *http.Request) (*http.Response, error) {
+	e.request = req.Clone(req.Context())
+	status := e.status
+	if status == 0 {
+		status = http.StatusOK
+	}
+	return &http.Response{
+		StatusCode: status,
+		Header:     http.Header{"Content-Type": []string{"application/json"}},
+		Body:       io.NopCloser(strings.NewReader(e.body)),
+	}, nil
+}
+
+func TestProviderModelListsForwardToProvider(t *testing.T) {
+	cases := []struct {
+		name        string
+		provider    string
+		path        string
+		header      map[string]string
+		metadata    map[string]any
+		wantURL     string
+		wantHeaders map[string]string
+	}{
+		{
+			name:     "codex",
+			provider: "codex",
+			path:     "/v1/models?client_version=0.153.3",
+			header:   map[string]string{"User-Agent": "codex_cli_rs/0.153.3"},
+			metadata: map[string]any{"access_token": "codex-token", "account_id": "account-123"},
+			wantURL:  "https://chatgpt.com/backend-api/codex/models?client_version=0.153.3",
+			wantHeaders: map[string]string{
+				"Chatgpt-Account-Id": "account-123",
+				"Originator":         "codex_cli_rs",
+				"User-Agent":         "codex_cli_rs/0.153.3",
+			},
+		},
+		{
+			name:     "claude",
+			provider: "claude",
+			path:     "/v1/models?limit=1000",
+			header:   map[string]string{"User-Agent": "claude-cli/2.1.258 (external, cli)", "Anthropic-Version": "2023-06-01"},
+			metadata: map[string]any{"access_token": "claude-token"},
+			wantURL:  "https://api.anthropic.com/v1/models?limit=1000",
+			wantHeaders: map[string]string{
+				"Anthropic-Version": "2023-06-01",
+				"Anthropic-Beta":    "oauth-2025-04-20",
+			},
+		},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			server := newTestServer(t)
+			server.cfg.ProviderModelLists.Enabled = true
+			executor := &providerModelsCaptureExecutor{provider: tc.provider, body: `{"provider":"` + tc.provider + `"}`}
+			server.handlers.AuthManager.RegisterExecutor(executor)
+			credential := &auth.Auth{ID: tc.provider + "-auth", Provider: tc.provider, Status: auth.StatusActive, Metadata: tc.metadata}
+			if _, err := server.handlers.AuthManager.Register(context.Background(), credential); err != nil {
+				t.Fatalf("register auth: %v", err)
+			}
+
+			req := httptest.NewRequest(http.MethodGet, tc.path, nil)
+			req.Header.Set("Authorization", "Bearer test-key")
+			for name, value := range tc.header {
+				req.Header.Set(name, value)
+			}
+			rr := httptest.NewRecorder()
+			server.engine.ServeHTTP(rr, req)
+
+			if rr.Code != http.StatusOK {
+				t.Fatalf("status = %d body=%s", rr.Code, rr.Body.String())
+			}
+			if got := rr.Body.String(); got != `{"provider":"`+tc.provider+`"}` {
+				t.Fatalf("body = %q, want provider payload unchanged", got)
+			}
+			if executor.request == nil {
+				t.Fatal("provider was not called")
+			}
+			if got := executor.request.URL.String(); got != tc.wantURL {
+				t.Fatalf("upstream URL = %q, want %q", got, tc.wantURL)
+			}
+			for name, want := range tc.wantHeaders {
+				if got := executor.request.Header.Get(name); got != want {
+					t.Fatalf("header %s = %q, want %q", name, got, want)
+				}
+			}
+		})
+	}
+}
+
+func TestProviderModelListsFallBackToCatalogWhenUpstreamFails(t *testing.T) {
+	server := newTestServer(t)
+	server.cfg.ProviderModelLists.Enabled = true
+	executor := &providerModelsCaptureExecutor{provider: "codex", status: http.StatusBadGateway, body: `{"error":"down"}`}
+	server.handlers.AuthManager.RegisterExecutor(executor)
+	credential := &auth.Auth{ID: "codex-auth", Provider: "codex", Status: auth.StatusActive, Metadata: map[string]any{"access_token": "codex-token"}}
+	if _, err := server.handlers.AuthManager.Register(context.Background(), credential); err != nil {
+		t.Fatalf("register auth: %v", err)
+	}
+
+	req := httptest.NewRequest(http.MethodGet, "/v1/models?client_version=0.153.3", nil)
+	req.Header.Set("Authorization", "Bearer test-key")
+	rr := httptest.NewRecorder()
+	server.engine.ServeHTTP(rr, req)
+
+	if rr.Code != http.StatusOK {
+		t.Fatalf("status = %d body=%s", rr.Code, rr.Body.String())
+	}
+	if !strings.Contains(rr.Body.String(), `"models"`) {
+		t.Fatalf("expected local Codex catalog fallback, got %s", rr.Body.String())
+	}
+}
+
+func TestProviderModelListsDisabledUsesCatalog(t *testing.T) {
+	server := newTestServer(t)
+	executor := &providerModelsCaptureExecutor{provider: "codex", body: `{"provider":"codex"}`}
+	server.handlers.AuthManager.RegisterExecutor(executor)
+	credential := &auth.Auth{ID: "codex-auth", Provider: "codex", Status: auth.StatusActive, Metadata: map[string]any{"access_token": "codex-token"}}
+	if _, err := server.handlers.AuthManager.Register(context.Background(), credential); err != nil {
+		t.Fatalf("register auth: %v", err)
+	}
+
+	req := httptest.NewRequest(http.MethodGet, "/v1/models?client_version=0.153.3", nil)
+	req.Header.Set("Authorization", "Bearer test-key")
+	rr := httptest.NewRecorder()
+	server.engine.ServeHTTP(rr, req)
+
+	if executor.request != nil {
+		t.Fatal("provider must not be called when provider model lists are disabled")
+	}
+	if rr.Code != http.StatusOK || !strings.Contains(rr.Body.String(), `"models"`) {
+		t.Fatalf("expected local catalog, got %d %s", rr.Code, rr.Body.String())
+	}
+}

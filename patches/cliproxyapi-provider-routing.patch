index 0000000..4185265
--- /dev/null
+++ b/internal/api/server_provider_models.go
@@ -0,0 +1,99 @@
+package api
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"strings"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	coreexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+	log "github.com/sirupsen/logrus"
+)
+
+// providerModelListsEnabled reports whether /v1/models must be answered by the
+// provider itself through an enrolled OAuth credential.
+func (s *Server) providerModelListsEnabled() bool {
+	return s != nil && s.cfg != nil && s.cfg.ProviderModelLists.Enabled && !s.cfg.Home.Enabled
+}
+
+// providerModelsHandler forwards the client's own model list request to the
+// provider. Codex clients (client_version query) reach the ChatGPT Codex backend;
+// Anthropic clients reach api.anthropic.com. The response body is returned
+// unchanged so the client sees exactly what its subscription offers. It returns
+// false when the local catalog must answer instead.
+func (s *Server) providerModelsHandler(c *gin.Context) bool {
+	if !s.providerModelListsEnabled() || s.handlers == nil || s.handlers.AuthManager == nil {
+		return false
+	}
+	provider := ""
+	upstreamURL := ""
+	headers := make(http.Header)
+	headers.Set("Accept", "application/json")
+	if value := strings.TrimSpace(c.GetHeader("User-Agent")); value != "" {
+		headers.Set("User-Agent", value)
+	}
+	if _, ok := c.Request.URL.Query()["client_version"]; ok {
+		provider = "codex"
+		upstreamURL = "https://chatgpt.com/backend-api/codex/models?" + c.Request.URL.RawQuery
+		headers.Set("Originator", "codex_cli_rs")
+		for _, name := range []string{"Version", "Session_id", "X-Client-Request-Id"} {
+			if value := strings.TrimSpace(c.GetHeader(name)); value != "" {
+				headers.Set(name, value)
+			}
+		}
+	} else if isAnthropicModelsRequest(c) {
+		provider = "claude"
+		upstreamURL = "https://api.anthropic.com/v1/models"
+		if c.Request.URL.RawQuery != "" {
+			upstreamURL += "?" + c.Request.URL.RawQuery
+		}
+		headers.Set("Anthropic-Version", "2023-06-01")
+		headers.Set("Anthropic-Beta", "oauth-2025-04-20")
+	} else {
+		return false
+	}
+
+	ctx := context.WithValue(c.Request.Context(), "gin", c)
+	selected, err := s.handlers.AuthManager.SelectAuth(ctx, provider, "", coreexecutor.Options{Headers: c.Request.Header.Clone()})
+	if err != nil || selected == nil || selected.AuthKind() != auth.AuthKindOAuth {
+		log.WithField("provider", provider).WithError(err).Debug("provider model list: no OAuth credential available, using local catalog")
+		return false
+	}
+	if provider == "codex" {
+		if accountID, ok := selected.Metadata["account_id"].(string); ok && strings.TrimSpace(accountID) != "" {
+			headers.Set("Chatgpt-Account-Id", accountID)
+		}
+	}
+	req, err := s.handlers.AuthManager.NewHttpRequest(ctx, selected, http.MethodGet, upstreamURL, nil, headers)
+	if err != nil {
+		log.WithField("provider", provider).WithError(err).Warn("provider model list: request build failed, using local catalog")
+		return false
+	}
+	resp, err := s.handlers.AuthManager.HttpRequest(ctx, selected, req)
+	if err != nil {
+		log.WithField("provider", provider).WithError(err).Warn("provider model list: upstream request failed, using local catalog")
+		return false
+	}
+	defer func() {
+		if errClose := resp.Body.Close(); errClose != nil {
+			log.WithError(errClose).Debug("provider model list: close response body")
+		}
+	}()
+	body, err := io.ReadAll(io.LimitReader(resp.Body, 8<<20))
+	if err != nil {
+		log.WithField("provider", provider).WithError(err).Warn("provider model list: read failed, using local catalog")
+		return false
+	}
+	if resp.StatusCode != http.StatusOK {
+		log.WithFields(log.Fields{"provider": provider, "status": resp.StatusCode}).Warn("provider model list: upstream error, using local catalog")
+		return false
+	}
+	contentType := resp.Header.Get("Content-Type")
+	if contentType == "" {
+		contentType = "application/json"
+	}
+	c.Data(http.StatusOK, contentType, body)
+	return true
+}

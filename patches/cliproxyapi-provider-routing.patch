+				}
+				r.Body.Close()
+				if tc.failure != nil && (calls == 1 || tc.repeat) {
+					return nil, &net.OpError{Op: "write", Net: "tcp", Err: tc.failure}
+				}
+				status := tc.status
+				if status == 0 {
+					status = 200
+				}
+				return &http.Response{StatusCode: status, Body: io.NopCloser(strings.NewReader("OK"))}, nil
+			})}
+			resp, err := transport.RoundTrip(req)
+			if calls != tc.want {
+				t.Fatalf("calls=%d want=%d err=%v", calls, tc.want, err)
+			}
+			if resp != nil {
+				resp.Body.Close()
+			}
+			if tc.want == 2 && !tc.repeat && (err != nil || resp == nil || resp.StatusCode != 200) {
+				t.Fatalf("retry failed: resp=%v err=%v", resp, err)
+			}
+		})
+	}
+}
+
+func TestCodexStreamFailureIsNotReplayed(t *testing.T) {
+	calls := 0
+	reader, writer := io.Pipe()
+	writer.CloseWithError(syscall.ECONNRESET)
+	transport := &fallbackRoundTripper{chrome: utlsClientRoundTripFunc(func(req *http.Request) (*http.Response, error) {
+		calls++
+		return &http.Response{StatusCode: 200, Body: reader}, nil
+	})}
+	req, err := http.NewRequest(http.MethodGet, "https://chatgpt.com/backend-api/codex/responses", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	resp, err := transport.RoundTrip(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, err = io.ReadAll(resp.Body)
+	resp.Body.Close()
+	if !errors.Is(err, syscall.ECONNRESET) || calls != 1 {
+		t.Fatalf("calls=%d err=%v", calls, err)
+	}
+}

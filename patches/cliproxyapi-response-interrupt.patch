+package executor
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+)
+
+func TestFleetCodexWebsocketDisconnectSurvivesOutputBackpressure(t *testing.T) {
+	server := codexWebsocketServer(t, codexCreatedEvent, codexOutputAddedEvent,
+		`{"type":"response.output_text.delta","delta":"one"}`,
+		`{"type":"response.output_text.delta","delta":"two"}`)
+	defer server.Close()
+	exec := NewCodexWebsocketsExecutor(codexBufferingConfig(true))
+	exec.store = &codexWebsocketSessionStore{sessions: make(map[string]*codexWebsocketSession)}
+	const session = "fleet-backpressure"
+	defer exec.CloseExecutionSession(session)
+	disconnect := exec.UpstreamDisconnectChan(session)
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	ctx = cliproxyexecutor.WithDownstreamWebsocket(ctx)
+	req, opts := codexWebsocketRequest()
+	opts.Metadata = map[string]any{cliproxyexecutor.ExecutionSessionMetadataKey: session}
+	result, err := exec.ExecuteStream(ctx, codexTestAuth(server.URL), req, opts)
+	if err != nil || result == nil {
+		t.Fatalf("stream: %v", err)
+	}
+	defer func() {
+		cancel()
+		for range result.Chunks {
+		}
+	}()
+	select {
+	case <-disconnect:
+	case <-time.After(time.Second):
+		t.Fatal("upstream EOF notification blocked behind unread output")
+	}
+}

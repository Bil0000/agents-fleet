+			send(create)
+			expect("response.completed")
+			send(create)
+			expect("response.created")
+			expect("response.output_text.delta")
+			send(`{"type":"response.interrupt","response_id":"r2","mode":"discard_partial_items"}`)
+			expect("response.interrupt.accepted")
+			expect("response.incomplete")
+			send(create)
+			expect("response.completed")

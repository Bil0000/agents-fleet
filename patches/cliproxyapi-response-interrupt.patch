+				defer func() { _ = conn.Close() }()
+				_ = conn.SetReadDeadline(time.Now().Add(10 * time.Second))
+				read := func() []byte {
+					_, payload, errRead := conn.ReadMessage()
+					if errRead != nil {
+						t.Errorf("read upstream: %v", errRead)

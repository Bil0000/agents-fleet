+func TestFleetCodexWebsocketModelAccessFailoverKeepsSocketAndInterrupts(t *testing.T) {
+	for _, immediateClose := range []bool{false, true} {
+		t.Run(fmt.Sprintf("immediate_close=%t", immediateClose), func(t *testing.T) {
+			gin.SetMode(gin.TestMode)

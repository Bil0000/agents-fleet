+			router.GET("/v1/responses", handler.ResponsesWebsocket)
+			downstream := httptest.NewServer(router)
+			defer downstream.Close()
+			headers := http.Header{"Session-Id": []string{"fleet-model-access-session"}}
+			client, _, err := websocket.DefaultDialer.Dial("ws"+strings.TrimPrefix(downstream.URL, "http")+"/v1/responses", headers)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer func() { _ = client.Close() }()
+			_ = client.SetReadDeadline(time.Now().Add(10 * time.Second))
+			send := func(payload string) {
+				t.Helper()
+				if err := client.WriteMessage(websocket.TextMessage, []byte(payload)); err != nil {
+					t.Fatal(err)
+				}
+			}
+			expect := func(event string) {
+				t.Helper()
+				_, payload, err := client.ReadMessage()
+				if err != nil {
+					t.Fatal(err)
+				}
+				if gjson.GetBytes(payload, "type").String() != event {
+					t.Fatalf("want %s, got %s", event, payload)

@@ -0,0 +1,135 @@
+package executor
+
+import (
+	"context"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/gorilla/websocket"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+)
+
+func TestFleetCodexWebsocketModelAccessBootstrapGuards(t *testing.T) {
+	const accountError = `{"type":"error","status":400,"error":{"type":"invalid_request_error","code":"model_not_found","message":"The 'fleet-model-access' model is not supported when using Codex with a ChatGPT account."}}`
+	const requestError = `{"type":"error","status":400,"error":{"type":"invalid_request_error","code":"invalid_parameter","message":"Invalid request option"}}`
+	for _, tc := range []struct {
+		name        string
+		frames      []string
+		wantNotify  bool
+		wantPayload bool
+	}{
+		{"account_before_output", []string{accountError}, false, false},
+		{"request_fault", []string{requestError}, true, false},
+		{"account_after_output", []string{codexCreatedEvent, codexOutputAddedEvent, accountError}, true, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			server := codexWebsocketServerHoldingConnection(t, tc.frames...)
+			defer server.Close()
+			cfg := codexBufferingConfig(true)
+			cfg.OAuthRequestScopedErrors = map[string][]config.RequestScopedErrorRule{
+				"codex": {
+					{Status: 400, Match: []string{"model is not supported when using Codex with a ChatGPT account."}, Action: cliproxyauth.RequestScopedActionContinueAndCooldown},
+					{Status: 400, MatchRegexr: []string{"(?s).*"}, Action: cliproxyauth.RequestScopedActionStop},
+				},
+			}
+			exec := NewCodexWebsocketsExecutor(cfg)
+			exec.store = &codexWebsocketSessionStore{sessions: make(map[string]*codexWebsocketSession)}
+			const session = "fleet-model-access-guard"
+			defer exec.CloseExecutionSession(session)
+			disconnect := exec.UpstreamDisconnectChan(session)
+			auth := codexTestAuth(server.URL)
+			auth.Provider = "codex"
+			delete(auth.Attributes, "api_key")
+			auth.Metadata = map[string]any{"access_token": "synthetic-token"}
+			req, opts := codexWebsocketRequest()
+			opts.Metadata = map[string]any{cliproxyexecutor.ExecutionSessionMetadataKey: session}
+			result, err := exec.ExecuteStream(context.Background(), auth, req, opts)
+			if tc.wantPayload {
+				if err != nil || result == nil {
+					t.Fatalf("expected an active stream, got result=%v err=%v", result, err)
+				}
+				combined, streamErr := drainChunks(result)
+				if !strings.Contains(combined, "response.output_item.added") || streamErr == nil {
+					t.Fatalf("output and terminal error were not delivered in-stream: %s err=%v", combined, streamErr)
+				}
+				err = streamErr
+			} else if result != nil || err == nil {
+				t.Fatalf("expected a synchronous pre-output error, got result=%v err=%v", result, err)
+			}
+			if got := statusCodeFromTestError(t, err); got != http.StatusBadRequest {
+				t.Fatalf("status=%d, want400", got)
+			}
+			if tc.wantNotify {
+				select {
+				case <-disconnect:
+				case <-time.After(time.Second):
+					t.Fatal("terminal request/after-output failure lost its disconnect notification")
+				}
+			} else {
+				select {
+				case <-disconnect:
+					t.Fatal("retryable pre-output account failure closed the downstream session")
+				default:
+				}
+			}
+		})
+	}
+}
+
+func TestFleetCodexWebsocketTerminalReadReleasesOnOwnerExit(t *testing.T) {
+	for _, exit := range []string{"consumer", "session", "lifecycle"} {
+		t.Run(exit, func(t *testing.T) {
+			server := codexWebsocketServer(t, `{"type":"error","status":400,"error":{"message":"terminal"}}`)
+			defer server.Close()
+			client, _, err := websocket.DefaultDialer.Dial("ws"+strings.TrimPrefix(server.URL, "http"), nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer func() { _ = client.Close() }()
+			exec := NewCodexWebsocketsExecutor(nil)
+			exec.store = &codexWebsocketSessionStore{sessions: make(map[string]*codexWebsocketSession)}
+			const session = "fleet-terminal-owner"
+			defer exec.CloseExecutionSession(session)
+			sess := exec.getOrCreateSession(session)
+			sess.conn, sess.readerConn = client, client
+			sess.connCloser = newWebsocketConnectionCloser(client)
+			sess.configureConn(client)
+			reads := sess.activateWithBootstrap(client, make(chan struct{}))
+			finished := make(chan struct{})
+			go func() { exec.readUpstreamLoop(sess, client); close(finished) }()
+			if err := client.WriteMessage(websocket.TextMessage, []byte(`{"type":"response.create"}`)); err != nil {
+				t.Fatal(err)
+			}
+			for index := 0; index < 2; index++ {
+				select {
+				case event := <-reads:
+					if index == 0 && len(event.payload) == 0 || index == 1 && event.err == nil {
+						t.Fatalf("terminal FIFO event%d: %+v", index, event)
+					}
+				case <-time.After(time.Second):
+					t.Fatal("terminal read delivery stalled")
+				}
+			}
+			switch exit {
+			case "consumer":
+				sess.clearActive(client, reads)
+			case "session":
+				exec.CloseExecutionSession(session)
+			case "lifecycle":
+				if err := sess.closeBoundConnection(client, sess.connCloser, newTerminalFailureLifecycle()); err != nil {
+					t.Fatal(err)
+				}
+			}
+			select {
+			case <-finished:
+			case <-time.After(time.Second):
+				t.Fatal("terminal reader did not exit with its owner")
+			}
+		})
+	}
+}

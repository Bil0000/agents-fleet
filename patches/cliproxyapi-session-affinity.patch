+func (s *SessionAffinitySelector) withResetGeneration(ctx context.Context, metadata map[string]any) context.Context {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	s.resetMu.RLock()
+	generation := s.resetGeneration
+	metadata[fleetSessionAffinityGenerationMetadataKey] = generation
+	s.resetMu.RUnlock()
+	return context.WithValue(ctx, fleetSessionAffinityGenerationContextKey{}, generation)
 }
 

+func TestFleetSessionAffinityResetRejectsStaleCandidateBinding(t *testing.T) {
+	for _, provider := range []string{"claude", "codex"} {
+		for _, mixed := range []bool{false, true} {
+			for _, explicit := range []bool{false, true} {
+				name := provider + "/single/legacy"
+				if mixed {
+					name = provider + "/mixed/legacy"
+				}
+				if explicit {
+					name += "/explicit"
+				}
+				t.Run(name, func(t *testing.T) {
+					ctx := context.Background()
+					s := NewSessionAffinitySelectorWithConfig(SessionAffinityConfig{Fallback: &FillFirstSelector{}, TTL: time.Hour})
+					defer s.Stop()
+					manager := NewManager(nil, s, nil)
+					manager.RegisterExecutor(schedulerProviderTestExecutor{provider: provider})
+					for id, priority := range map[string]string{"a": "2", "b": "1"} {
+						if _, err := manager.Register(ctx, &Auth{ID: id, Provider: provider, Attributes: map[string]string{"priority": priority}}); err != nil {
+							t.Fatal(err)
+						}
+					}
+					first := true
+					manager.SetPluginScheduler(&fakePluginScheduler{pick: func(context.Context, pluginapi.SchedulerPickRequest) (pluginapi.SchedulerPickResponse, bool, error) {
+						if first {
+							first = false
+							for _, account := range manager.List() {
+								if account.ID == "b" {
+									account.Attributes["priority"] = "3"
+									if _, err := manager.Update(ctx, account); err != nil {
+										t.Fatal(err)
+									}
+								}
+							}
+							s.InvalidateAuth("a")
+							s.InvalidateAuth("b")
+						}
+						return pluginapi.SchedulerPickResponse{}, false, nil
+					}})
+					opts := cliproxyexecutor.Options{
+						SourceFormat:    translator.FormatOpenAI,
+						OriginalRequest: []byte(`{"messages":[{"role":"user","content":"hello"}]}`),
+						Metadata:        map[string]any{cliproxyexecutor.CallerScopeMetadataKey: "caller"},
+					}
+					if explicit {
+						opts.Headers = http.Header{"Session-Id": []string{"native-session"}}
+					}
+					pick := func() (*Auth, error) {
+						if mixed {
+							auth, _, _, err := manager.pickNextMixed(ctx, []string{provider}, "", opts, nil)
+							return auth, err
+						}
+						auth, _, err := manager.pickNext(ctx, provider, "", opts, nil)
+						return auth, err
+					}
+					old, err := pick()
+					if err != nil || old == nil {
+						t.Fatalf("in-flight selection = %v, %v", old, err)
+					}
+					s.OnResult(Result{AuthID: old.ID, Provider: provider, Success: true, Options: opts})
+					next, err := pick()
+					if err != nil || next == nil || next.ID != "b" {
+						t.Fatalf("selection after stale candidate = %v, %v; want manual choice b", next, err)
+					}
+				})
+			}
+		}
+	}
+}

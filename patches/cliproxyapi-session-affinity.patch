+func TestFleetSessionAffinityResetRejectsDelayedResults(t *testing.T) {
+	for _, explicit := range []bool{false, true} {
+		name := "legacy"
+		if explicit {
+			name = "explicit"
+		}
+		t.Run(name, func(t *testing.T) {
+			s := NewSessionAffinitySelectorWithConfig(SessionAffinityConfig{Fallback: &FillFirstSelector{}, TTL: time.Hour})
+			defer s.Stop()
+			auths := []*Auth{{ID: "a", Attributes: map[string]string{"priority": "2"}}, {ID: "b", Attributes: map[string]string{"priority": "1"}}}
+			opts := cliproxyexecutor.Options{
+				SourceFormat:    translator.FormatOpenAI,
+				OriginalRequest: []byte(`{"messages":[{"role":"user","content":"hello"}]}`),
+				Metadata:        map[string]any{cliproxyexecutor.CallerScopeMetadataKey: "caller"},
+			}
+			if explicit {
+				opts.Headers = http.Header{"Session-Id": []string{"native-session"}}
+			}
+			first, err := s.Pick(context.Background(), "claude", "model", opts, auths)
+			if err != nil || first == nil || first.ID != "a" {
+				t.Fatalf("initial selection = %v, %v; want a", first, err)
+			}
+			auths[1].Attributes["priority"] = "3"
+			s.InvalidateAuth("a")
+			s.InvalidateAuth("b")
+			done := make(chan struct{})
+			go func() {
+				defer close(done)
+				for i := 0; i < 100; i++ {
+					s.OnResult(Result{AuthID: "a", Provider: "claude", Model: "model", Success: true, Options: opts})
+				}
+			}()
+			for i := 0; i < 100; i++ {
+				s.InvalidateAuth("a")
+			}
+			<-done
+			next, err := s.Pick(context.Background(), "claude", "model", opts, auths)
+			if err != nil || next == nil || next.ID != "b" {
+				t.Fatalf("selection after delayed result = %v, %v; want manual choice b", next, err)
+			}
+		})
+	}
+}

+func TestFleetSessionAffinityResetPreservesOtherProviderResults(t *testing.T) {
+	s := NewSessionAffinitySelectorWithConfig(SessionAffinityConfig{Fallback: &FillFirstSelector{}, TTL: time.Hour})
+	defer s.Stop()
+	auths := []*Auth{{ID: "codex-a", Attributes: map[string]string{"priority": "2"}}, {ID: "codex-b", Attributes: map[string]string{"priority": "1"}}}
+	opts := cliproxyexecutor.Options{
+		SourceFormat:    translator.FormatOpenAI,
+		OriginalRequest: []byte(`{"messages":[{"role":"user","content":"hello"}]}`),
+		Metadata:        map[string]any{cliproxyexecutor.CallerScopeMetadataKey: "caller"},
+	}
+	first, err := s.Pick(context.Background(), "codex", "model", opts, auths)
+	if err != nil || first == nil || first.ID != "codex-a" {
+		t.Fatalf("initial selection = %v, %v; want codex-a", first, err)
+	}
+	s.InvalidateAuth("claude-a")
+	s.matcher.InvalidateAuth("codex-a")
+	s.OnResult(Result{AuthID: "codex-a", Provider: "codex", Model: "model", Success: true, Options: opts})
+	auths[1].Attributes["priority"] = "3"
+	next, err := s.Pick(context.Background(), "codex", "model", opts, auths)
+	if err != nil || next == nil || next.ID != "codex-a" {
+		t.Fatalf("other provider result binding = %v, %v; want codex-a", next, err)
+	}
+}

+package management
+
+import (
+	"net/http"
+
+	"github.com/gin-gonic/gin"
+)
+
+func (h *Handler) ResetFleetSessionAffinity(c *gin.Context) {
+	var request struct {
+		Provider string `json:"provider"`
+	}
+	if c.ShouldBindJSON(&request) != nil || (request.Provider != "claude" && request.Provider != "codex") {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "provider must be claude or codex"})
+		return
+	}
+	if h.authManager == nil {
+		c.JSON(http.StatusServiceUnavailable, gin.H{"error": "auth manager unavailable"})
+		return
+	}
+	selector, ok := h.authManager.Selector().(interface{ InvalidateAuth(string) })
+	if !ok {
+		c.JSON(http.StatusConflict, gin.H{"error": "session affinity is not enabled"})
+		return
+	}
+	for _, account := range h.authManager.List() {
+		if account.Provider == request.Provider {
+			selector.InvalidateAuth(account.ID)
+		}
+	}
+	c.JSON(http.StatusOK, gin.H{"status": "ok"})
+}

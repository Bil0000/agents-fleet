+func TestFleetSessionAffinityCreditAndDisabledEligibility(t *testing.T) {
+	for _, provider := range []string{"claude", "codex"} {
+		for _, mode := range []string{"never", "last"} {
+			for _, mixed := range []bool{false, true} {
+				path := "/single"
+				if mixed {
+					path = "/mixed"
+				}
+				t.Run(provider+"/"+mode+path, func(t *testing.T) {
+					ctx := context.Background()
+					file := filepath.Join(t.TempDir(), "routing.json")
+					t.Setenv("FLEET_ACCOUNT_ROUTING_FILE", file)
+					setMode := func(mode string) {
+						t.Helper()
+						policy, _ := json.Marshal(map[string]any{"version": 1, "credits": map[string]string{provider: mode}})
+						if err := os.WriteFile(file, policy, 0600); err != nil {
+							t.Fatal(err)
+						}
+					}
+					available := `{"rate_limit":{"limit_reached":false,"primary_window":{"used_percent":0}},"credits":{"has_credits":true}}`
+					exhausted := `{"rate_limit":{"limit_reached":true,"primary_window":{"used_percent":100}},"credits":{"has_credits":true}}`
+					if provider == "claude" {
+						available = `{"five_hour":{"utilization":0},"seven_day":{"utilization":0},"extra_usage":{"is_enabled":true,"monthly_limit":100,"used_credits":0}}`
+						exhausted = `{"five_hour":{"utilization":100},"seven_day":{"utilization":0},"extra_usage":{"is_enabled":true,"monthly_limit":100,"used_credits":0}}`
+					}
+					executor := &fleetCreditTestExecutor{schedulerProviderTestExecutor: schedulerProviderTestExecutor{provider: provider}, bodies: map[string]string{"a": exhausted, "b": available}}
+					affinity := NewSessionAffinitySelectorWithConfig(SessionAffinityConfig{Fallback: &FillFirstSelector{}, TTL: time.Hour})
+					defer affinity.Stop()
+					manager := NewManager(nil, affinity, nil)
+					manager.RegisterExecutor(executor)
+					for id, priority := range map[string]string{"a": "2", "b": "1"} {
+						if _, err := manager.Register(ctx, &Auth{ID: id, Provider: provider, Status: StatusActive, Attributes: map[string]string{AttributeAuthKind: AuthKindOAuth, "priority": priority}}); err != nil {
+							t.Fatal(err)
+						}
+					}
+					opts := cliproxyexecutor.Options{Headers: http.Header{"Session-Id": []string{"stable-session"}}}
+					pick := func(want string) {
+						t.Helper()
+						var got *Auth
+						var err error
+						if mixed {
+							got, _, _, err = manager.pickNextMixed(ctx, []string{provider}, "", opts, nil)
+						} else {
+							got, _, err = manager.pickNext(ctx, provider, "", opts, nil)
+						}
+						if want == "" {
+							if err == nil || got != nil {
+								t.Fatalf("got %v, %v; want blocked", got, err)
+							}
+						} else if err != nil || got == nil || got.ID != want {
+							t.Fatalf("got %v, %v; want %s", got, err, want)
+						}
+					}
+					setMode("same-account")
+					pick("a")
+					for _, account := range manager.List() {
+						if account.ID == "b" {
+							account.Attributes["priority"] = "3"
+							if _, err := manager.Update(ctx, account); err != nil {
+								t.Fatal(err)
+							}
+						}
+					}
+					pick("a")
+					setMode(mode)
+					pick("b")
+					for _, account := range manager.List() {
+						if account.ID == "b" {
+							account.Disabled = true
+							account.Status = StatusDisabled
+							if _, err := manager.Update(ctx, account); err != nil {
+								t.Fatal(err)
+							}
+						}
+					}
+					if mode == "last" {
+						pick("a")
+					} else {
+						pick("")
+					}
+				})
+			}
+		}
+	}
+}
